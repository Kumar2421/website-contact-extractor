# Supabase (Project Settings > API Keys). The secret key is server-only: never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Public URL of the deployment (used in the crawler user agent and webhooks).
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Protects /api/cron/* and internal batch chaining. Vercel sends it as a Bearer token to cron routes.
CRON_SECRET=generate-a-long-random-string
# Optional AI company summaries (Google AI Studio key).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
